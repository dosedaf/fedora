// waybar - Blackout port of the nix/hyprland config
// Stowed from ~/fedora -> ~/.config/waybar/config
// hyprland/workspaces -> sway/workspaces, hyprland/window -> sway/window
// Palette is black + greys: see style.css
{
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 9,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "network", "clock"],

    "sway/workspaces": {
        "all-outputs": false,
        // every workspace is a dot, state comes from style.css
        "format": "●",
        // keep all ten slots on screen even when empty, so the dot
        // position still means a workspace number
        "persistent-workspaces": {
            "1:eDP-1": ["eDP-1"],
            "2:eDP-1": ["eDP-1"],
            "3:eDP-1": ["eDP-1"],
            "4:eDP-1": ["eDP-1"],
            "5:eDP-1": ["eDP-1"],
            "6:eDP-1": ["eDP-1"],
            "7:eDP-1": ["eDP-1"],
            "8:eDP-1": ["eDP-1"],
            "9:eDP-1": ["eDP-1"],
            "10:eDP-1": ["eDP-1"],
            "1:HDMI-A-1": ["HDMI-A-1"],
            "2:HDMI-A-1": ["HDMI-A-1"],
            "3:HDMI-A-1": ["HDMI-A-1"],
            "4:HDMI-A-1": ["HDMI-A-1"],
            "5:HDMI-A-1": ["HDMI-A-1"],
            "6:HDMI-A-1": ["HDMI-A-1"],
            "7:HDMI-A-1": ["HDMI-A-1"],
            "8:HDMI-A-1": ["HDMI-A-1"],
            "9:HDMI-A-1": ["HDMI-A-1"],
            "10:HDMI-A-1": ["HDMI-A-1"]
        }
    },

    "sway/mode": {
        "format": "<i>{}</i>"
    },

    "sway/window": {
        "max-length": 60,
        "format": "{title}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}\uf294",
        "format-bluetooth-muted": "\uf6a9 {icon}\uf294",
        "format-icons": {
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"],
            "handsfree": "\uf590",
            "headphones": "\uf025",
            "headset": "\uf590",
            "phone": "\uf095",
            "portable": "\uf095"
        },
        "format-muted": "\uf6a9 {format_source}",
        "format-source": "\uf130",
        "format-source-muted": "\uf131",
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 1,
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected \u26a0",
        "format-ethernet": "gacorrr",
        "format-linked": "{ifname} (No IP) \uf796",
        "format-wifi": "\uf1eb"
    }
}
