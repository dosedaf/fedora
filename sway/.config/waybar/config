// waybar - Blackout port of the nix/hyprland config
// Stowed from ~/fedora -> ~/.config/waybar/config
// hyprland/workspaces -> sway/workspaces, hyprland/window -> sway/window
// Palette is black + greys: see style.css
{
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 9,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "network", "clock"],

    "sway/workspaces": {
        "all-outputs": false,
        // every workspace is a dot, state comes from style.css;
        // only workspaces that actually exist get one
        "format": "●"
    },

    "sway/mode": {
        "format": "<i>{}</i>"
    },

    "sway/window": {
        "max-length": 60,
        "format": "{title}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}\uf294",
        "format-bluetooth-muted": "\uf6a9 {icon}\uf294",
        "format-icons": {
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"],
            "handsfree": "\uf590",
            "headphones": "\uf025",
            "headset": "\uf590",
            "phone": "\uf095",
            "portable": "\uf095"
        },
        "format-muted": "\uf6a9 {format_source}",
        "format-source": "\uf130",
        "format-source-muted": "\uf131",
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 1,
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected \u26a0",
        "format-ethernet": "gacorrr",
        "format-linked": "{ifname} (No IP) \uf796",
        "format-wifi": "\uf1eb"
    }
}
