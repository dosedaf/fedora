# mako — notifications, Blackout flavour
# Stowed from ~/fedora -> ~/.config/mako/config

font=JetBrainsMono Nerd Font Mono 10

background-color=#000000
text-color=#e0e0e0
border-color=#404040
border-size=1
border-radius=0

progress-color=over #404040
icons=1
max-icon-size=32
icon-path=/usr/share/icons/hicolor

default-timeout=6000
group-by=app-name

width=380
height=120
margin=8
padding=10
anchor=top-right
